# Environment: development | production
ENVIRONMENT=development

# Required in production — openssl rand -hex 32
SECRET_KEY=dev-only-change-me
JWT_LIFETIME_SECONDS=3600

# SQLite (default for local Poetry) or Postgres
# DB_PATH=./data/tradenet-chat.db
# DATABASE_URL=sqlite+aiosqlite:///./data/tradenet-chat.db
# Docker Compose / local Postgres:
# DATABASE_URL=postgresql+asyncpg://tradenet:tradenet@127.0.0.1:5432/tradenet_chat

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

API_HOST=0.0.0.0
API_PORT=8000

# LLM: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Neo4j (same graph tradenet loads into Browser)
# Compose uses password tradenet (8+ chars required by Neo4j 5)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j
NEO4J_DATABASE=neo4j

# NewsAPI.org (https://newsapi.org) — optional; DuckDuckGo news works without it
NEWS_API_KEY=
